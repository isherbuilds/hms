{
  "name": "better-stack",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.14",
      "hono": "^4.12.32",
      "@orpc/server": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "better-auth": "1.6.25",
      "evlog": "^2.22.4",
      "ai": "^7.0.41",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@orpc/client": "^1.14.12",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "drizzle-orm": "^0.45.2",
      "@types/pg": "^8.20.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run db:up && bun run db:migrate && turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types && tsc --noEmit -p tests/tsconfig.json",
    "test": "bun test --max-concurrency 1 --timeout 15000 tests",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:up": "docker compose -f packages/db/docker-compose.dev.yaml up -d --wait",
    "db:push": "turbo run db:push -F @better-stack/db",
    "db:studio": "turbo run db:studio -F @better-stack/db",
    "db:generate": "turbo run db:generate -F @better-stack/db",
    "db:migrate": "turbo run db:migrate -F @better-stack/db",
    "db:seed": "bun --env-file=apps/server/.env scripts/seed.ts",
    "create-user": "bun --env-file=apps/server/.env scripts/create-user.ts",
    "create-founder": "bun --env-file=apps/server/.env scripts/create-founder.ts",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@better-stack/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-stack/api": "workspace:*",
    "@better-stack/auth": "workspace:*",
    "@better-stack/config": "workspace:*",
    "@better-stack/db": "workspace:*",
    "@better-stack/storage": "workspace:*",
    "@orpc/server": "catalog:",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-orm": "catalog:",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "pg": "^8.22.0",
    "turbo": "^2.10.8",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
