{
  "name": "hms",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.5.4",
      "typescript": "^7.0.2",
      "@types/bun": "^1.4.1",
      "hono": "^4.13.5",
      "@orpc/server": "^1.15.0",
      "@orpc/openapi": "^1.15.0",
      "@orpc/zod": "^1.15.0",
      "better-auth": "^1.7.2",
      "evlog": "^2.27.1",
      "lucide-react": "^1.37.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@orpc/client": "^1.15.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "drizzle-orm": "^0.45.2",
      "@types/pg": "^8.21.0",
      "react-hook-form": "^7.87.0",
      "@hookform/resolvers": "^5.9.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run db:up && bun run db:migrate && turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types && tsc --noEmit -p tests/tsconfig.json",
    "test": "bun test --max-concurrency 1 --timeout 15000 tests && bun test --max-concurrency 1 --timeout 15000 ./tests/isolated/files-delete-resilience.isolated.ts",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "dev:status": "bun scripts/dev-status.ts",
    "db:up": "docker compose -f packages/db/docker-compose.dev.yaml up -d --wait",
    "db:push": "turbo run db:push -F @hms/db",
    "db:studio": "turbo run db:studio -F @hms/db",
    "db:generate": "turbo run db:generate -F @hms/db",
    "db:migrate": "turbo run db:migrate -F @hms/db",
    "db:seed": "bun scripts/seed.ts",
    "db:seed:volume": "bun scripts/seed-volume.ts",
    "benchmark:browser": "bun scripts/benchmark-browser.ts",
    "benchmark:server": "bun scripts/benchmark-server.ts",
    "benchmark:rpc": "bun scripts/benchmark-rpc.ts",
    "create-user": "bun scripts/create-user.ts",
    "create-founder": "bun scripts/create-founder.ts",
    "cleanup-uploads": "bun scripts/cleanup-uploads.ts",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@hms/env": "workspace:*"
  },
  "devDependencies": {
    "@hms/api": "workspace:*",
    "@hms/auth": "workspace:*",
    "@hms/config": "workspace:*",
    "@hms/db": "workspace:*",
    "@orpc/client": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@types/bun": "^1.4.1",
    "@types/pg": "^8.23.1",
    "chrome-devtools-axi": "^0.1.34",
    "drizzle-orm": "^0.45.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "pg": "^8.23.0",
    "portless": "^0.15.6",
    "takumi-js": "^2.13.6",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
