{
  "name": "hms",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^7.0.2",
      "@types/bun": "^1.3.14",
      "hono": "^4.13.2",
      "@orpc/server": "^1.15.0",
      "@orpc/openapi": "^1.15.0",
      "@orpc/zod": "^1.15.0",
      "better-auth": "1.6.28",
      "evlog": "^2.26.0",
      "ai": "^7.0.65",
      "lucide-react": "^1.31.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@orpc/client": "^1.15.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "drizzle-orm": "^0.45.2",
      "@types/pg": "^8.21.0",
      "react-hook-form": "^7.85.0",
      "@hookform/resolvers": "^5.8.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run db:up && bun run db:migrate && turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types && tsc --noEmit -p tests/tsconfig.json",
    "test": "bun test --max-concurrency 1 --timeout 15000 tests",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:up": "docker compose -f packages/db/docker-compose.dev.yaml up -d --wait",
    "db:push": "turbo run db:push -F @hms/db",
    "db:studio": "turbo run db:studio -F @hms/db",
    "db:generate": "turbo run db:generate -F @hms/db",
    "db:migrate": "turbo run db:migrate -F @hms/db",
    "db:seed": "bun --env-file=apps/server/.env scripts/seed.ts",
    "create-user": "bun --env-file=apps/server/.env scripts/create-user.ts",
    "create-founder": "bun --env-file=apps/server/.env scripts/create-founder.ts",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@hms/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hms/api": "workspace:*",
    "@hms/auth": "workspace:*",
    "@hms/config": "workspace:*",
    "@hms/db": "workspace:*",
    "@hms/storage": "workspace:*",
    "@orpc/server": "catalog:",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-orm": "catalog:",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "pg": "^8.23.0",
    "turbo": "^2.10.10",
    "typescript": "catalog:"
  },
  "overrides": {
    "mermaid": "11.16.1",
    "nanoid": "3.3.18"
  },
  "packageManager": "bun@1.3.14"
}
