# Copy to packages/env/.env and fill in. This is the only .env in the repo: the
# API server, the web app's SSR runtime, drizzle-kit and the operator scripts
# all read it through @hms/env, and Vite reads the VITE_* names from it too.
#
# Required values and every supplied value are validated at import time by
# packages/env/src. The optional storage group's completeness is checked at
# first use, as noted below.

# ============================================================
# Server — required
# ============================================================

# Postgres. The dev instance in packages/db/docker-compose.dev.yaml listens on
# 55442 so it never collides with a local system Postgres on 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:55442/postgres

# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# Where the API itself is reachable, and the single browser origin allowed to
# call it. CORS_ORIGIN is also the base for invitation links.
#
# Development runs behind the portless proxy (see docs/development.md), so these
# are named HTTPS hosts, not ports. Running with PORTLESS=0 instead? Use
# http://localhost:3000 and http://localhost:3001 and drop the cookie domain.
BETTER_AUTH_URL=https://api.hms.localhost
CORS_ORIGIN=https://hms.localhost

# Required whenever the web app and the API sit on different hosts, which is
# true both in production and under portless. The API sets the cookie on the
# parent domain so the web host receives it during SSR and hard refreshes.
BETTER_AUTH_COOKIE_DOMAIN=.hms.localhost

# Operator identity: the only account allowed to create organizations (decision
# D006). Run `bun run create-founder <name> <password>` to provision it.
FOUNDING_EMAIL=test@test.com

# development | production | test. Production disables development-only
# tooling, including the unauthenticated OpenAPI reference.
NODE_ENV=development

# ============================================================
# Web — required
# ============================================================

# Origin the browser's oRPC link calls. Baked into the client bundle at build
# time, so a production image must be built with the production value.
VITE_SERVER_URL=https://api.hms.localhost

# The site's own public origin, with no path or trailing slash. Builds canonical
# URLs, the sitemap and Open Graph URLs; baked into the bundle like the above.
VITE_WEB_URL=https://hms.localhost

# Public contact channels rendered on /contact and in the footer. The WhatsApp
# number is E.164 digits without the plus sign (the wa.me form).
VITE_WHATSAPP_NUMBER=919999999999
VITE_CONTACT_EMAIL=hello@hms.localhost

# ============================================================
# Server — optional: file storage
# ============================================================
# Leave all four core values unset to run without upload or read URLs;
# valid-sized requests then return a named configuration error while metadata
# lists still work. Upload-size validation runs first and may reject an
# oversized request before that configuration check. A partial group fails when
# the storage client is first used. Values below match
# packages/db/docker-compose.dev.yaml.
#
# Note: the bucket must NOT be anonymously readable. Every object is served
# through a short-lived presigned URL — see packages/storage/src/index.ts.

SEAWEEDFS_ENDPOINT=http://localhost:55451
SEAWEEDFS_BUCKET=files
SEAWEEDFS_ACCESS_KEY_ID=better-stack
SEAWEEDFS_SECRET_ACCESS_KEY=better-stack-secret

# Rejected above this size, before any presigned URL is issued. Default 100 MiB.
# SEAWEEDFS_MAX_UPLOAD_BYTES=104857600
