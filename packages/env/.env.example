# Copy to packages/env/.env and fill in. This is the only .env in the repo: the
# API server, the web app's SSR runtime, drizzle-kit and the operator scripts
# all read it through @hms/env, and Vite reads the VITE_* names from it too.
#
# Every variable here is validated at import time by packages/env/src — a
# misconfigured deployment fails at boot rather than at the first request that
# needs the value.

# ============================================================
# Server — required
# ============================================================

# Postgres. The dev instance in packages/db/docker-compose.dev.yaml listens on
# 55442 so it never collides with a local system Postgres on 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:55442/postgres

# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# Where the API itself is reachable, and the single browser origin allowed to
# call it. CORS_ORIGIN is also the base for invitation links.
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# Required in production when web and API use separate subdomains.
# BETTER_AUTH_COOKIE_DOMAIN=.example.com

# Operator identity: the only account allowed to create organizations (ADR
# 0014). Run `bun run create-founder <name> <password>` to provision it.
FOUNDING_EMAIL=test@test.com

# development | production | test. Production disables development-only
# tooling, including the unauthenticated OpenAPI reference.
NODE_ENV=development

# ============================================================
# Web — required
# ============================================================

# Origin the browser's oRPC link calls. Baked into the client bundle at build
# time, so a production image must be built with the production value.
VITE_SERVER_URL=http://localhost:3000

# ============================================================
# Server — optional: file storage
# ============================================================
# Leave unset to run without file uploads; the Files page will then return a
# configuration error. Values below match packages/db/docker-compose.dev.yaml.
#
# Note: the bucket must NOT be anonymously readable. Every object is served
# through a short-lived presigned URL — see packages/storage/src/index.ts.

SEAWEEDFS_ENDPOINT=http://localhost:55451
SEAWEEDFS_BUCKET=files
SEAWEEDFS_ACCESS_KEY_ID=better-stack
SEAWEEDFS_SECRET_ACCESS_KEY=better-stack-secret

# Rejected above this size, before any presigned URL is issued. Default 100 MB.
# SEAWEEDFS_MAX_UPLOAD_BYTES=104857600

# ============================================================
# Server — optional: AI chat
# ============================================================
# Required only by the /ai route in apps/server/src/index.ts.
